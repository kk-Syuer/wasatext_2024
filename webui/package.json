{
	"name": "teapot",
	"version": "0.0.0",
	"scripts": {
		"dev": "yarn install --immutable --immutable-cache && vite",
		"build": "yarn install --immutable --immutable-cache && vite build --mode production",
		"build-dev": "yarn install --immutable --immutable-cache && vite build --mode development",
		"build-prod": "yarn install --immutable --immutable-cache && vite build --mode production",
		"build-embed": "yarn install --immutable --immutable-cache && vite build --mode production --base=/dashboard/",
		"preview": "vite preview --port 4173"
	},
	"dependencies": {
		"axios": "1.13.5",
		"vue": "^3.2.37",
		"vue-router": "^4.1.3"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "4.6.2",
		"vite": "4.5.6"
	},
	"packageManager": "yarn@4.5.0",
	"resolutions": {
		"glob": "10.5.0",
		"tar": "7.5.3",
		"minimatch": "9.0.6",
		"form-data": "4.0.4"
	},
	"overrides": {
		"glob": "10.5.0",
		"tar": "7.5.3",
		"minimatch": "9.0.6",
		"form-data": "4.0.4"
	}
}
